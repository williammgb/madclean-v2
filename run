#!/bin/sh
# One entrypoint for this project. Every command a person or an agent runs goes
# through here: one place to look, one thing to allowlist, one thing that can't
# drift from what SPEC.md claims the commands are.
#
# The Python project is the repository root, so every task runs from here and the
# gate stamps and the journal land in .work/.
set -eu
cd "$(dirname "$0")"

# A gate that passes stamps .work/gates/<task>.stamp. The commit hook compares
# those stamps against the files being committed and refuses a commit the fast
# gate never saw — gate output older than the code it is quoted as proving is not
# evidence.
stamp() {
  mkdir -p .work/gates
  date -u +%Y-%m-%dT%H:%M:%SZ > ".work/gates/$1.stamp"
}

# One line in .work/JOURNAL.md, the project's record of what was tested. A gate run
# with the same result as the line just above it adds nothing, so the builder's
# inner loop of fast-gate reruns does not bury everything else.
journal() {
  file=.work/JOURNAL.md
  [ -f "$file" ] || return 0
  last=$(grep -v '^[[:space:]]*$' "$file" | tail -n 1)
  case "$last" in "- ${1%% (*}"*) return 0 ;; esac
  [ -z "$(tail -c 1 "$file")" ] || echo >> "$file"
  printf -- '- %s\n' "$1" >> "$file"
}

# gate <name> <command...>
# Runs one gate with its output shown as it goes. A filtered run (./run fast -k name)
# proved a subset, not the gate, so it neither stamps nor writes to the journal. A
# full run stamps when it passes, and journals either way with the last line the
# command printed — for most test runners, the count.
gate() {
  name=$1; shift
  if [ "$filtered" -gt 0 ]; then "$@"; return; fi
  mkdir -p .work/gates
  log=".work/gates/$name.log"
  rm -f "$log.code"
  started=$(date +%s)
  { "$@" && echo 0 > "$log.code" || echo $? > "$log.code"; } 2>&1 | tee "$log"
  code=$(cat "$log.code" 2>/dev/null || echo 1)
  took=$(( $(date +%s) - started ))
  if [ "$code" -eq 0 ]; then result=passed; stamp "$name"; else result=failed; fi
  said=$(tr -d '\000' < "$log" | grep -av '^[[:space:]]*$' | tail -n 1 | tr -d '\033' | cut -c1-160)
  journal "$name gate $result (${took}s): $said"
  return "$code"
}

py() {
  uv run --frozen "$@"
}

# pytest goes through `python -m`: Windows Application Control blocks the
# pytest.exe launcher that uv writes into the virtual environment on this machine.
fast_gate() {
  py ruff check . && py python -m pytest -q -m "not slow" "$@"
}

full_gate() {
  py ruff check . && py python -m pytest -q "$@"
}

# port_from_log <log> <text before the url>: the port Reflex says it is using.
port_from_log() {
  sed 's/\x1b\[[0-9;]*[A-Za-z]//g' "$1" | tr -d '\r' | grep -ao "$2 http://[^:/]*:[0-9]*" | grep -o '[0-9]*$' | tail -n 1
}

# app_start <name>: starts the GUI the way a person does (madclean-ui), logging to
# .work/gates/<name>-ui.log, and sets front and back to the ports it says it uses.
# smoke_gate: waits until the page and the backend answer, then stops every process
# it started.
#
# Reflex moves to the next free port when 3000 or 8000 is taken — by another
# checkout's smoke gate running at the same time, or by the demo app — so the gate
# reads the ports from the app's own log instead of assuming them. The app runs
# inside scripts/run_in_job.py: creating the stop file ends it and every process it
# started, and it ends by itself after 10 minutes, even when nothing is left to
# create the stop file.
app_start() {
  mkdir -p .work/gates
  ui_log=".work/gates/$1-ui.log"
  stop=".work/gates/$1-ui.stop"
  rm -f "$stop"
  py python scripts/run_in_job.py --stop-file "$stop" --max-seconds 600 -- madclean-ui > "$ui_log" 2>&1 &
  ui_pid=$!
  front=""; back=""; waited=0
  while [ -z "$front" ] || [ -z "$back" ]; do
    kill -0 "$ui_pid" 2> /dev/null || break
    [ "$waited" -lt 300 ] || break
    sleep 2
    waited=$((waited + 2))
    front=$(port_from_log "$ui_log" "App running at:")
    back=$(port_from_log "$ui_log" "Backend running at:")
  done
}

# app_up: the app app_start started said its ports, and both answer.
app_up() {
  [ -n "$front" ] && [ -n "$back" ] \
    && curl -fsS --retry 30 --retry-delay 2 --retry-connrefused --retry-all-errors --max-time 10 "http://localhost:$front/" > /dev/null \
    && curl -fsS --max-time 10 "http://localhost:$back/ping" > /dev/null
}

# app_stop: ends the app app_start started, then fails when anything is left running.
app_stop() {
  touch "$stop"
  tries=0
  while kill -0 "$ui_pid" 2> /dev/null; do
    tries=$((tries + 1))
    if [ "$tries" -ge 15 ]; then
      kill "$ui_pid" 2> /dev/null || true
      echo "gui: still running 15s after the stop file, a process was left running"
      return 1
    fi
    sleep 1
  done
  rm -f "$stop"
  if [ -n "$front" ] && { curl -fsS --max-time 2 "http://localhost:$back/ping" > /dev/null 2>&1 \
     || curl -fsS --max-time 2 "http://localhost:$front/" > /dev/null 2>&1; }; then
    echo "gui: ports $front/$back still answer after shutdown, a process was left running"
    return 1
  fi
}

smoke_gate() {
  py madclean --help > /dev/null || return 1
  echo "cli: madclean --help ran"
  app_start smoke
  up=0
  if [ -n "$front" ] && [ -n "$back" ]; then
    echo "gui: app on port $front, backend on port $back (after ${waited}s)"
    if app_up; then
      up=1
      browser_check "$front" || up=0
    fi
  else
    echo "gui: the app did not say which ports it uses within ${waited}s"
  fi
  app_stop || return 1
  if [ "$up" -eq 1 ]; then
    echo "gui: page rendered in the browser with no console errors; backend /ping answered"
  else
    echo "gui: did not come up cleanly, last lines of $ui_log:"
    tail -n 20 "$ui_log"
    return 1
  fi
}

# browser_check <port>: renders the page in headless Microsoft Edge, then fails on a
# missing app title or any console error the page itself logged. Each checkout gets
# its own Edge profile folder, so two gates at once do not share one.
browser_check() {
  port=$1
  edge="/c/Program Files (x86)/Microsoft/Edge/Application/msedge.exe"
  if [ ! -x "$edge" ]; then
    echo "browser: Microsoft Edge not found at $edge"
    return 1
  fi
  mkdir -p .work/tmp
  "$edge" --headless=new --disable-gpu --enable-logging=stderr --v=0 \
    --user-data-dir="$(pwd -W)/.work/tmp/smoke-edge" --virtual-time-budget=20000 \
    --dump-dom "http://localhost:$port/" > .work/gates/smoke-dom.html 2> .work/gates/smoke-console.log || true
  if ! grep -q "MADClean" .work/gates/smoke-dom.html; then
    echo "browser: rendered page does not contain MADClean"
    return 1
  fi
  if grep "CONSOLE" .work/gates/smoke-console.log | grep "localhost:$port" | grep -qi "ERROR\|Uncaught"; then
    echo "browser: console errors from the page:"
    grep "CONSOLE" .work/gates/smoke-console.log | grep "localhost:$port" | grep -i "ERROR\|Uncaught" | cut -c1-240
    return 1
  fi
  echo "browser: page rendered, $(grep -c "CONSOLE" .work/gates/smoke-console.log) console messages, none are errors"
}

# Starts the app with the offline demo model — MADCLEAN_DEMO_LLM_SECONDS, 5 s a reply
# unless set, so no paid call is ever made — runs every browser script in tests/ui/
# against it with its address, then stops it. The scripts drive the installed
# Microsoft Edge through Playwright, which uv adds for this run only; each saves its
# screenshots under .work/screens/.
ui_gate() {
  MADCLEAN_DEMO_LLM_SECONDS="${MADCLEAN_DEMO_LLM_SECONDS:-5}"
  export MADCLEAN_DEMO_LLM_SECONDS
  mkdir -p .work/screens
  app_start ui
  ok=0
  if app_up; then
    echo "gui: app on port $front, backend on port $back (after ${waited}s), demo model answers in ${MADCLEAN_DEMO_LLM_SECONDS}s"
    ok=1
    for script in tests/ui/*.py; do
      echo "ui: $script"
      py --with playwright python "$script" "http://localhost:$front/" || ok=0
    done
  else
    echo "gui: did not come up, last lines of $ui_log:"
    tail -n 20 "$ui_log"
  fi
  app_stop || return 1
  if [ "$ok" -ne 1 ]; then
    echo "ui: a browser script failed"
    return 1
  fi
  echo "ui: every browser script in tests/ui passed"
}

# One benchmark run of one dataset with the real model from .env (costs API tokens).
# Not a gate: it never stamps, but its result line goes into the journal.
live_run() {
  dataset=$1
  mkdir -p .work/gates
  log=.work/gates/live.log
  rm -f "$log.code"
  started=$(date +%s)
  { py python -m evaluation.live_run "$dataset" && echo 0 > "$log.code" || echo $? > "$log.code"; } 2>&1 | tee "$log"
  code=$(cat "$log.code" 2>/dev/null || echo 1)
  took=$(( $(date +%s) - started ))
  if [ "$code" -eq 0 ]; then result=passed; else result=failed; fi
  said=$(grep -v '^[[:space:]]*$' "$log" | tail -n 1 | tr -d '\033' | cut -c1-200)
  journal "live $dataset $result (${took}s): $said"
  return "$code"
}

usage() {
  cat <<'USAGE'
usage: ./run <task> [args]

  setup   install Python 3.12 and the locked dependencies (uv sync --frozen)
  fast    the fast gate — ruff, then tests not marked slow (under ~60s, no network)
  full    the full gate — ruff, then every test at real size
  smoke   run madclean --help, start madclean-ui and wait until it answers
  ui      start madclean-ui with the free demo model and run the browser scripts in tests/ui
  check   lint one file:  ./run check path/to/file.py
  score   re-score every stored MADClean run and baseline, offline, in both modes
  live    one real-model benchmark run, costs API tokens:  ./run live beers
USAGE
}

task="${1:-}"
[ $# -gt 0 ] && shift
filtered=$#

case "$task" in
  setup) uv sync --frozen ;;
  fast)  gate fast fast_gate "$@" ;;
  full)  gate full full_gate "$@" ;;
  smoke) gate smoke smoke_gate ;;
  ui)    gate ui ui_gate ;;
  score) py python -m madclean.evaluation.scoreboard "$@" ;;
  live)
    if [ -z "${1:-}" ]; then echo "usage: ./run live <dataset>" >&2; exit 1; fi
    live_run "$1" ;;
  check)
    case "${1:-}" in
      *.py) uv run --frozen ruff check "$1" ;;
      *) exit 0 ;;
    esac ;;
  ""|-h|--help|help) usage ;;
  *) echo "run: unknown task '$task'" >&2; usage >&2; exit 1 ;;
esac
